# NagrikSetu Production Environment Variables Template
# In production / Vercel deployment, configure these variables in project settings.
# NEVER commit real credentials or secret keys to version control.

# Application URL (Configured in Vercel)
NEXT_PUBLIC_APP_URL=https://your-production-app.vercel.app

# Demo Mode Flag
# IMPORTANT: For production zero-trust security, this MUST be set to false.
# When set to false, all demo credentials and passwordless demo bypasses are strictly disabled.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase Authentication & Database (Configured in Vercel)
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Privileged Secret (Configured in Vercel as Encrypted Secret)
# Used ONLY on the server for admin role checks. Never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Assistant Provider Configuration (Optional for Ask Guide)
# Options: gemini | openai | mock
AI_PROVIDER=gemini
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=gemini-1.5-flash
