# NagrikSetu Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (true enables offline/embedded mock database so app is 100% testable out-of-the-box)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Configuration (Optional for local demo, Required for full Supabase production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Provider Configuration (Optional - graceful fallback provided if not set)
# Options: gemini | openai | mock
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
